{
  "name": "ExternalRedirect",
  "version": "1.3.0",
  "author": [
    "Davis Mosenkovs",
    "MediaWiki 1.46 compatibility update"
  ],
  "url": "https://www.mediawiki.org/wiki/Extension:ExternalRedirect",
  "descriptionmsg": "externalredirect-desc",
  "type": "parserhook",
  "license-name": "GPL-2.0-or-later",
  "requires": {
    "MediaWiki": ">= 1.46.0"
  },
  "MessagesDirs": {
    "ExternalRedirect": [
      "i18n"
    ]
  },
  "AutoloadClasses": {
    "ExternalRedirectHooks": "ExternalRedirect.php"
  },
  "config": {
    "ExternalRedirectNsIDs": {
      "value": [],
      "description": "Namespace IDs in which external redirects are allowed."
    },
    "ExternalRedirectPages": {
      "value": [],
      "description": "Fully prefixed page names on which external redirects are allowed."
    },
    "ExternalRedirectURLRegex": {
      "value": "",
      "description": "PCRE pattern that target URLs must match; use a strict allowlist."
    },
    "ExternalRedirectDeniedShowURL": {
      "value": false,
      "description": "Show the target URL when an external redirect is denied."
    }
  },
  "Hooks": {
    "ParserFirstCallInit": "ExternalRedirectHooks::onParserFirstCallInit",
    "OutputPageParserOutput": "ExternalRedirectHooks::onOutputPageParserOutput"
  },
  "manifest_version": 2,
  "ExtensionMessagesFiles": {
    "ExternalRedirectMagic": "ExternalRedirect.i18n.magic.php"
  }
}
